<?xml version="1.0" encoding="utf-8"?>
<!-- docs/PROTOCOL.md §8, §9.5: no unencrypted connections, and only the system's certificate authorities (never ones
     the user added). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
