<?xml version="1.0" encoding="utf-8"?>
<!-- No permission at all: the files go to Sealdrop over the bound service, Sealdrop does the network. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11 and later show an app only the packages it names. -->
    <queries>
        <package android:name="app.sealdrop" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="Example Sender"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
